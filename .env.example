# Laravel API, used for server-side fetches at build/revalidation time
API_URL=http://localhost:8000
# Same API, as seen from the visitor's browser (contact form)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: separate origin for uploaded images when MEDIA_DISK=s3 on the API
MEDIA_URL=

# Must match REVALIDATE_SECRET in the API's .env
REVALIDATE_SECRET=

# Cloudflare Turnstile site key; leave empty to hide the widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public URL of this site (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
